.godot/
.import/
*.import
*.tmp
**/*.import
project.godot
work/
**/__pycache__/
**/issue_list.md
docs/issues/issue-list.md

# Asset generation workspace.
# Raw images, normalized frames, candidate sheets, and validation reports are
# local working files. Keep the directory marker so Godot ignores the same
# files as well.
/assets/generated/*
!/assets/generated/.gdignore
/assets/manifests/*
!/assets/manifests/.gdignore
/assets/motions/*
!/assets/motions/.gdignore
/assets/specs/*
!/assets/specs/.gdignore
