[Unit]
Description=Skill Battle lobby API
After=network-online.target
Wants=network-online.target

[Service]
User=skill-battle
WorkingDirectory=/opt/skill-battle/lobby
EnvironmentFile=/etc/skill-battle/lobby.env
ExecStart=/opt/skill-battle/lobby/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
